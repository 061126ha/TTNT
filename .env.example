OPENROUTER_API_KEY=
# Chat model — any model available on openrouter.ai/models
OPENROUTER_CHAT_MODEL=google/gemini-2.0-flash-001
# Embedding model — must support the /embeddings endpoint on OpenRouter
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Reranker: "none" | "cross_encoder" | "llm" | "cohere"
RERANKER_TYPE="cohere"
# How many raw FAISS results to fetch before reranking (multiplied by RETRIEVAL_TOP_K, ignored when RERANKER_TYPE=none)
RERANK_FETCH_MULTIPLIER=3
# Final number of chunks after reranking (defaults to RETRIEVAL_TOP_K)
RERANK_TOP_K=5
# Cross-encoder model name from HuggingFace (RERANKER_TYPE=cross_encoder)
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
# Cohere API key and model (RERANKER_TYPE=cohere)
# COHERE_API_KEY=nhap_api_key_cua_ban_vao_day
# COHERE_RERANK_MODEL=rerank-multilingual-v3.0